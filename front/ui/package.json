{
  "name": "shodh-front-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "shodh Associative Memory dashboard. Built as a React app, shipped as one self-contained index.html that the shodh-front Rust binary embeds at compile time.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
