    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "motion": "^13.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
